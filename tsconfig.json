{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    // The app runs on Preact. Source still imports from `"react"` — these
    // paths resolve those specifiers to `preact/compat` for `tsc`, mirroring
    // the aliases `@preact/preset-vite` installs for the bundler. Keep the two
    // lists in sync; a specifier mapped here but not there (or vice versa)
    // type-checks against one runtime and ships another.
    "paths": {
      "react": ["./node_modules/preact/compat/"],
      "react/jsx-runtime": ["./node_modules/preact/jsx-runtime"],
      "react-dom": ["./node_modules/preact/compat/"],
      "react-dom/client": ["./node_modules/preact/compat/client"],
      "react-dom/test-utils": ["./node_modules/preact/test-utils"],
      // The phone app's native modules, which only `native/` installs: a test
      // that imports a `native/src` file type-checks it against these stubs
      // (the same files `test.alias` in vite.config.ts resolves to), and
      // `native/`'s own tsc checks it against the real packages.
      "expo-file-system/legacy": ["./tests/native/stubs/expo-file-system.ts"],
      "expo-sharing": ["./tests/native/stubs/expo-sharing.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["vite/client", "vite-plugin-pwa/client", "vitest/globals"]
  },
  "include": ["src", "tests", "vite.config.ts"]
}
