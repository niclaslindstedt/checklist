{
  "name": "checklist",
  "version": "1.4.0",
  "description": "A local-first PWA checklist app with template support and optional Dropbox sync.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_SEED=demo vite",
    "build": "vite build",
    "build:native": "VITE_NATIVE=1 vite build --outDir native/webroot --emptyOutDir && node scripts/website-only.mjs native/webroot",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "icons": "pwa-assets-generator",
    "tauri": "npm --prefix tauri run start",
    "tauri:fast": "npm --prefix tauri run start:fast",
    "tauri:bundle": "npm --prefix tauri run bundle",
    "tauri:install": "npm --prefix tauri install",
    "tauri:test": "npm --prefix tauri run test",
    "tauri:lint": "npm --prefix tauri run lint",
    "tauri:fmt": "npm --prefix tauri run fmt",
    "tauri:fmt:check": "npm --prefix tauri run fmt:check",
    "tauri:package": "npm run tauri:install && npm --prefix tauri run package --",
    "tauri:package:debug": "npm run tauri:install && npm --prefix tauri run package:debug --",
    "tauri:clean": "npm --prefix tauri run clean"
  },
  "author": "Niclas Lindstedt <nicl@slindstedt.se>",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@niclaslindstedt/oss-framework": "^3.12.0",
    "preact": "^10.29.8",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.19.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vite-pwa/assets-generator": "^1.0.4",
    "eslint": "^10.11.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "preact-render-to-string": "^6.7.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "workbox-build": {
      "glob": "^13.0.6"
    },
    "react": "npm:@preact/compat@^18.3.2",
    "react-dom": "npm:@preact/compat@^18.3.2"
  },
  "allowScripts": {
    "fsevents": false
  }
}
